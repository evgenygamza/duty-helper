# Единственный файл с секретами. Кладётся в ~/.config/duty-helper/secrets.env,
# права 600, в репозиторий не попадает. Значения здесь выдуманные.
#
# Всё несекретное — в duty.toml, см. config.example.toml.
#
# Запуск:  set -a; . ~/.config/duty-helper/secrets.env; set +a

# --- Slack -------------------------------------------------------------
# Токены бота и приложения подставляет `slack run`, здесь они нужны только
# для запуска голым python.
# SLACK_BOT_TOKEN=xoxb-...
# SLACK_APP_TOKEN=xapp-...

# Токен человека: поиск по каналам, где бота нет, и отметки от его лица.
# Вид: xoxp-<цифры>-<цифры>-<цифры>-<буквы и цифры>
SLACK_USER_TOKEN=

# --- Модель ------------------------------------------------------------
# Вид: AIza…, берётся в AI Studio
GEMINI_API_KEY=

# --- Портал поставщика данных ------------------------------------------
# Вход идёт headless-браузером, одноразовый код бот читает из почты по IMAP.
FACTSET_EMAIL=duty@example.com
FACTSET_PASSWORD=
IMAP_HOST=imap.example.com
# Пароль приложения, не основной пароль от почты
IMAP_PASSWORD=
IMAP_FOLDER=INBOX
OTP_SENDER=noreply@example.com

# Кого ставить в копию при обращении к поставщику, через запятую.
CC_COLLEAGUES=colleague@example.com
